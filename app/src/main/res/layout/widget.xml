<?xml version="1.0" encoding="utf-8"?>
<!-- WatchLater+ Home screen widget: the count on top, the next video below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFB22E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="videos to watch"
            android:textColor="#9C9AA6"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WatchLater+"
            android:textColor="#F3F1EC"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_thumb_bg"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/w_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Next video"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/w_nothumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#F3F1EC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="Play"
                android:padding="9dp"
                android:src="@drawable/widget_play" />
        </FrameLayout>

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F3F1EC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#9C9AA6"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_done"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="All caught up 🍿\nShare a video to WatchLater+ to save it here."
        android:textColor="#9C9AA6"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
